# Postgres connection string. Works with Vercel Postgres, Supabase, Neon, Railway, or your own.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# The URL your app is deployed at (http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# From https://console.cloud.google.com/apis/credentials — only needed for "Continue with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
